{
  "schema_version": 1,
  "language": "C#",
  "runtime": ".NET 8 / System.Text.Json",
  "runner": "ubuntu-24.04",
  "runtime_probe": ["dotnet", "--version"],
  "cases": [
    {
      "id": "CSHARP-001",
      "purpose": "A versioned JSON reader accepts version one and rejects version two.",
      "test": "tests/Program.cs",
      "support": [
        "tests/Contracts.csproj"
      ],
      "commands": [
        [
          "dotnet",
          "build",
          "tests/Contracts.csproj",
          "--output",
          "{tmp}/dotnet",
          "-p:BaseIntermediateOutputPath={tmp}/obj/"
        ],
        [
          "dotnet",
          "{tmp}/dotnet/Contracts.dll"
        ]
      ]
    }
  ]
}
